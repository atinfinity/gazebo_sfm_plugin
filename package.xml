<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_sfm_plugin</name>
  <version>2.0.0</version>
  <description>Social Force Model pedestrian plugin for Gazebo (Harmonic / gz-sim 8) on ROS 2 Jazzy</description>

  <maintainer email="dandelion1124@gmail.com">atinfinity</maintainer>

  <license>BSD</license>

  <url type="repository">https://github.com/atinfinity/gazebo_sfm_plugin</url>

  <author>Noé Pérez</author>
  <author email="dandelion1124@gmail.com">atinfinity</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Social Force Model library (standalone, header-only) -->
  <depend>lightsfm</depend>

  <!-- Gazebo Harmonic (provided as ROS vendor packages on Jazzy) -->
  <depend>gz_sim_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_common_vendor</depend>

  <!-- Launch / simulation integration -->
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
